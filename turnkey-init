"""
Execute firstboot initialization hooks, skipping blacklist

firstboot.d hook execution environment:

    _TURNKEY_INIT=1

"""
import os
import signal
import sys

from conffile import ConfFile
import subprocess


def fatal(e):
    print("error: " + str(e), file=sys.stderr)
    sys.exit(1)


def usage(e=None):
    if e:
        print("error: " + str(e), file=sys.stderr)

    print("Syntax: %s [-h|--help] [-c|--full-confconsole] [--setup-only]\n" % (sys.argv[0]), file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    print("\nOptions:\n")
    print("  -h|--help             - print this help and exit")
    print("  -c|--full-confconsole - after initialization open full confconsole (default is basic).")
    print("                          If Confconsole not installed, will be ignored.")
    print("  --setup-only          - return after initialization without opening Confconsole.")
    print("\nBlacklist:\n", file=sys.stderr)
    for script in BLACKLIST:
        print("    %s" % script, file=sys.stderr)
    sys.exit(1)


# deprecated: hooks can use _TURNKEY_INIT to detect if they're running under
# turnkey-init
BLACKLIST = ['15regen-sslcert',
             '92etckeeper', ]


class Config(ConfFile):
    CONF_FILE = "/etc/default/inithooks"


class InitHooks:
    def __init__(self):
        self.conf = Config()

    @staticmethod
    def _exec(cmd):
        result = subprocess.run(['env',
                        'PATH=/usr/local/sbin:/usr/local/bin:'
                        '/usr/sbin:/usr/bin:/sbin:/bin',
                        cmd])
        # Security updates are intentionally skipped on live media.
        if os.path.basename(cmd) == '95secupdates' and result.returncode == 2:
            return
        result.check_returncode()

    def execute(self, dname):
        os.environ['_TURNKEY_INIT'] = '1'
        dpath = os.path.join(self.conf.inithooks_path, dname)
        if not os.path.exists(dpath):
            return

        scripts = os.listdir(dpath)
        scripts.sort()
        for fname in scripts:
            fpath = os.path.join(dpath, fname)
            if os.access(fpath, os.X_OK) and fname not in BLACKLIST:
                self._exec(fpath)


def main():
    if os.geteuid() != 0:
        fatal("turnkey-init must be run with root permissions")

    confconsole = '/usr/bin/confconsole'
    if os.path.exists(confconsole) and os.access(confconsole, os.X_OK):
        confconsole = [confconsole, '--usage']
    else:
        # /bin/true ignores args and always returns true
        confconsole = ['/bin/true', '--null']

    args = sys.argv[1:]
    setup_only = False
    if args:
        for arg in args:
            if arg in ('-h', '--help'):
                usage()
            if arg in ('-c', '--full-confconsole'):
                confconsole = confconsole[:-1]
            if arg == '--setup-only':
                setup_only = True

    # The active hook owns Ctrl-C and can ask before aborting setup.
    previous_sigint = signal.signal(signal.SIGINT, signal.SIG_IGN)
    inithooks = InitHooks()
    try:
        inithooks.execute('firstboot.d')
    except subprocess.CalledProcessError as error:
        if setup_only:
            fatal("Setup stopped at %s. Correct the error and try again."
                  % os.path.basename(error.cmd[-1]))
        fatal("Setup stopped at %s. Correct the error and run turnkey-init again."
              % os.path.basename(error.cmd[-1]))
    finally:
        signal.signal(signal.SIGINT, previous_sigint)

    if setup_only:
        return

    # The console owns Ctrl-C and can offer to quit. A caught signal handler
    # is reset on exec, so the child still receives SIGINT normally.
    previous_sigint = signal.signal(signal.SIGINT, lambda signum, frame: None)
    try:
        returncode = subprocess.run(confconsole).returncode
    finally:
        signal.signal(signal.SIGINT, previous_sigint)
    if returncode == 130 or returncode == -signal.SIGINT:
        return 130


if __name__ == "__main__":
    sys.exit(main())
