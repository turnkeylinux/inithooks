#!/bin/bash -e
# reconfigure: no
# reconfigure-title: Finalize Setup
# reconfigure-description: Clear provisioning values and mark first boot complete.

INITHOOKS_DEFAULT=/etc/default/inithooks
. $INITHOOKS_DEFAULT

"$INITHOOKS_PATH/bin/turnkey-onboarding" event --name setup_completed

# blank out configuration file (usually contains passwords)
[ -e $INITHOOKS_CONF ] && echo > $INITHOOKS_CONF

# set run_firstboot to false
sed -i '/RUN_FIRSTBOOT/ s/=.*/=false/g' $INITHOOKS_DEFAULT

exit 0

