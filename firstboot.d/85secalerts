#!/bin/bash -e
# reconfigure: yes
# reconfigure-title: Security contact
# reconfigure-description: Configure the recipient for system notification emails.
# enable security alert emails
# SEC_ALERTS: SKIP, $EMAIL (if none specified, will be interactive)

. /etc/default/inithooks

[ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
[ "${_TURNKEY_RECONFIGURE:-}" ] || [ "$SEC_ALERTS" != "SKIP" ] || {
    "$INITHOOKS_PATH/bin/turnkey-onboarding" notifications --email SKIP
    exit 0
}

$INITHOOKS_PATH/bin/secalerts.py \
    --email="$([ "${_TURNKEY_RECONFIGURE:-}" ] || printf %s "$SEC_ALERTS")" \
    --email-placeholder="$($INITHOOKS_PATH/bin/inithooks_cache.py APP_EMAIL)"
