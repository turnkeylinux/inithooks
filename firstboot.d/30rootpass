#!/bin/bash -e
# reconfigure: yes
# reconfigure-title: System Password
# reconfigure-description: Change the system administrator password used by SSH and Webmin.
# set root password

# Proxmox supplies this password when creating the container.
[[ -z "${_TURNKEY_RECONFIGURE:-}" && -e /var/lib/turnkey-info/inithooks.service/lxc ]] && exit 0

USERNAME=root

. /etc/default/inithooks
[ "$(echo $SUDOADMIN | tr [A-Z] [a-z] )" = "true" ] && USERNAME=admin

[ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
$INITHOOKS_PATH/bin/setpass.py $USERNAME --pass="$ROOT_PASS"

