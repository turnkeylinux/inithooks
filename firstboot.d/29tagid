#!/bin/bash

[ -n "$_TURNKEY_INIT" ] && exit 0

APP_NAME=$(perl -pe 's/^turnkey-//; s/-[^-]+(-[^-]+){2}$//' < /etc/turnkey_version)
VERSION=$(perl -pe 's/.*-([^-]+(-[^-]+){2})$/\1/' < /etc/turnkey_version)
BUILD=$(perl -ne 'chomp; s/.*\((.*)\).*/\1/; s/^\S+ ?//; $tags=$_ ? $_ : "iso"; system("echo $tags | xargs -n 1 | sort -u | xargs echo | sed \"s/ /-/g\"");' < /etc/apt/apt.conf.d/01turnkey)

### initfence 

# shellcheck source=default/turnkey-init-fence
source /etc/default/turnkey-init-fence

if [[ ! -d "$HTDOCS" ]]; then
    mkdir -p "$(dirname "$HTDOCS")"
    cp -R "/usr/lib/inithooks/turnkey-init-fence/htdocs" "$(dirname "$HTDOCS")"
fi

INITFENCE_INDEX="$HTDOCS/index.html"
sed -i "s|@APP_NAME@|$APP_NAME|" $INITFENCE_INDEX

# Setup observations are queued by 00setup-observation, independent of a browser.
sed -i '/<script src="https:\/\/ajax.turnkeylinux.org\/initfence\//d' "$INITFENCE_INDEX"

# reload init-fence to pick up the updated index
systemctl reload turnkey-init-fence
